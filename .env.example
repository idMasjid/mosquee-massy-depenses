# Base de données (gérée par Prisma, voir prisma.config.ts)
# En local: chemin relatif. Dans le conteneur Docker (voir compose.portainer.yml),
# cette valeur est fixée à "file:/app/data/dev.db" (volume nommé "app_data").
DATABASE_URL="file:./dev.db"

# Auth.js — générer avec: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Obligatoire. En déploiement Docker/Portainer, doit être renseigné dans les
# variables d'environnement de la Stack (jamais commité).
AUTH_SECRET=""

# Google Cloud Console > OAuth 2.0 Client ID (Web application)
# Redirect URI à configurer: http://localhost:3000/api/auth/callback/google
# Optionnel — la connexion Google ne s'active que si les deux sont renseignés.
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Dossier de stockage local des pièces jointes (hors /public)
# En local: chemin relatif. Dans le conteneur Docker, cette valeur est fixée
# à "/app/storage" (volume nommé "app_storage").
STORAGE_ROOT="./storage"

# Compte admin créé par `npm run db:seed` (optionnel, valeurs par défaut ci-dessous)
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="ChangeMoi123!"

# --- Déploiement Docker / Portainer uniquement (compose.portainer.yml) -----
# Port publié sur l'hôte (le conteneur écoute toujours en interne sur 3000).
APP_PORT="3000"
# Tag de l'image à déployer : "latest" (dernière version stable publiée par
# la CI) ou "sha-<sha_git_court>" pour cibler/revenir à une version précise.
IMAGE_TAG="latest"
